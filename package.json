{
  "name": "cbt-system-prototype",
  "version": "2.3.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "student:dev": "npm --workspace=apps/student run dev",
    "student:electron": "npm --workspace=apps/student run electron:dev",
    "student:build": "npm --workspace=apps/student run build",
    "manager:dev": "npm --workspace=apps/manager run dev",
    "manager:electron": "npm --workspace=apps/manager run electron:dev",
    "manager:build": "npm --workspace=apps/manager run build",
    "server:dev": "npm --workspace=apps/server run dev",
    "server:electron": "npm --workspace=apps/server run electron:dev",
    "server:build": "npm --workspace=apps/server run build",
    "release": "node scripts/build-release.js",
    "release:suite": "node scripts/build-release.js",
    "package:setup": "node scripts/package-setup.js",
    "package:server-updater": "node scripts/stage-server-updates.js",
    "release:bump": "node scripts/bump-version.js",
    "release:icons": "node scripts/generate-icons.js",
    "clean": "node scripts/clean.js",
    "api:audit": "node scripts/audit-api-routes.js",
    "license:hwid": "node scripts/get-hwid.js"
  }
}
